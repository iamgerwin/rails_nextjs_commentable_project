# Application Configuration
APP_NAME="Rails Next.js Commentable Project"
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://localhost/rails_nextjs_commentable_dev
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=5000

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_VERSION=v1
API_TIMEOUT=30000
API_RETRIES=3

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=100

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Upload Configuration
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_PATH=/uploads

# Pagination Configuration
PAGINATION_DEFAULT_PER_PAGE=25
PAGINATION_MAX_PER_PAGE=100

# Feature Flags
FEATURE_COMMENTS=true
FEATURE_REACTIONS=true
FEATURE_REPORTS=true
FEATURE_NOTIFICATIONS=false
FEATURE_ANALYTICS=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:4200
CORS_CREDENTIALS=true

# Rails Configuration
RAILS_ENV=development
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
RAILS_LOG_LEVEL=debug
RAILS_SERVE_STATIC_FILES=true

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:4200
PORT=4200

# Email Configuration (optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Sentry (optional)
SENTRY_DSN=

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
