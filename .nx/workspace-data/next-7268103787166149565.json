{
  "10125621351869371452": {
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/web/my-app",
        "tty": false
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "next"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/web/my-app/.next",
        "{workspaceRoot}/apps/web/my-app/.next/!(cache)"
      ]
    },
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/web/my-app"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/web/my-app"
      },
      "dependsOn": [
        "build"
      ]
    },
    "serve-static": {
      "command": "next start",
      "options": {
        "cwd": "apps/web/my-app"
      },
      "dependsOn": [
        "build"
      ]
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ]
    },
    "watch-deps": {
      "dependsOn": [
        "build-deps"
      ],
      "command": "npx nx watch --projects my-app --includeDependentProjects -- npx nx build-deps my-app"
    }
  },
